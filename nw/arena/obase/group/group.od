OBJECT(OBJI 0 0){
    Propiertes(OIPR 0 1){
        Comment  :="Начальник группы танков.
        !Префикс для событий - tg_ (tank group)"
        Header   :!"C:\NW\ARENA\OBASE\GROUP\group.h"
        CPP      :!"C:\NW\ARENA\OBASE\GROUP\group.cpp"
        Script   :!""
        Object   :!"TankGroup"
        ExtrenTab :!"TankGroup"
        ExternAttr:!"TankGroupTable"
        IsActiv  :true
        IsSubject:true
    }
    States(STB_ 0 0){
        (TKEY 0 1){State }
        State(STAT 0 0){
            State Head(STH_ 0 1){
                Name   :!"STAY"
                Comment:="умолчальный режим - 
                =для ничего 
                !не делания"
            }
            Point0(PN2I 0 1){
                x -194
                y 34
            }
            Point1(PN2I 0 1){
                x 214
                y 117
            }
            State links(STLN 0 1){
                Count: 2
                | 1                 0| 0 1
            }
        }
        (TKEY 0 1){State }
        State(STAT 0 0){
            State Head(STH_ 0 1){
                Name   :!"MOVING"
                Comment:="Движение вдоль некоторой траектории с использованием
                =набора трасс.
                =В процессе движения необходимо сканировать окружение
                =на предмет наличия врагов. - раз в 3-5 секунд.
                =Цикл сканирования врагов организуется посылкой
                !себе сообщения tg_EV_FIND_ENEMY"
            }
            Point0(PN2I 0 1){
                x 314
                y 32
            }
            Point1(PN2I 0 1){
                x 715
                y 149
            }
            State links(STLN 0 1){
                Count: 3
                | 2                 2| 1 1| 0 0
            }
        }
        (TKEY 0 1){EndOfState }
        (TKEY 0 1){StateLink }
        State link(STLN 0 0){
            State link description(STLD 0 1){
                Action function:!"gotoF"
                Comment        :="Основная команда - перейти всей группой в новую
                =точку
                =Необходимо запустить 2 цикла:
                =tg_EVC_FIND_ENEMY
                !tg_EVC_MOVING"
                Event          :!"tg_EVCMD_GO_TO"
            }
            Point0(SQRP 0 1){
                Edge num :1
                Ascpect  :0.319277
            }
            Point1(SQRP 0 1){
                Edge num :3
                Ascpect  :0.243590
            }
            Title(ETIT 0 1){
                pos.x:-25
                pos.y:-110
                asp 0.500000
            }
            States(STL_ 0 1){
                sour:0
                dest:1
            }
            Node list(SLNL 0 1){
                Count: 0

            }
        }

        (TKEY 0 1){StateLink }
        State link(STLN 0 0){
            State link description(STLD 0 1){
                Action function:!"move_ReachedF"
                Comment        :="Мы прибыли на место.
                =Возможно необходимо уведомить об этом 
                !командира"
                Event          :!"tg_EV_REACHED"
            }
            Point0(SQRP 0 1){
                Edge num :3
                Ascpect  :0.414530
            }
            Point1(SQRP 0 1){
                Edge num :1
                Ascpect  :0.560241
            }
            Title(ETIT 0 1){
                pos.x:-56
                pos.y:53
                asp 0.500000
            }
            States(STL_ 0 1){
                sour:1
                dest:0
            }
            Node list(SLNL 0 1){
                Count: 0

            }
        }

        (TKEY 0 1){StateLink }
        State link(STLN 0 0){
            State link description(STLD 0 1){
                Action function:!"movingFC"
                Comment        :="Движение по заданной трассе к указанной точке
                =Для продолжения цикла испускается tg_EVC_MOVING,
                !по прибытии на место - tg_EV_REACHED"
                Event          :!"tg_EVC_MOVING"
            }
            Point0(SQRP 0 1){
                Edge num :0
                Ascpect  :0.564838
            }
            Point1(SQRP 0 1){
                Edge num :0
                Ascpect  :0.390274
            }
            Title(ETIT 0 1){
                pos.x:-21
                pos.y:-83
                asp 0.500000
            }
            States(STL_ 0 1){
                sour:1
                dest:1
            }
            Node list(SLNL 0 1){
                Count: 2

                x: 540 y: 0
                x: 470 y: 0
            }
        }

        (TKEY 0 1){EndOfStateLink }    }
    AttrDescrVal(ADV_ 0 1){
        Val: -87114022
    }

    AttributeBase(ATRB 0 0){
        (TKEY 0 1){Attr }
        Attribute(ATRI 0 1){
