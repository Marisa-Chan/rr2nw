        (TKEY 0 1){Attr }
        Attribute(ATRI 0 1){
            Type       :!"DOUBLE"
            Name       :!"m_waitDist"
            DefaultVal :!"20.0"
            Comment    :!"Расстояние, при превышении которого ждем отставших"
        }
        (TKEY 0 1){Attr }
        Attribute(ATRI 0 1){
            Type       :!"DOUBLE"
