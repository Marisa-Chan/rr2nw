        }
        (TKEY 0 1){Attr }
        Attribute(ATRI 0 1){
            Type       :!"DOUBLE"
            Name       :!"m_nearDist"
            DefaultVal :!"10.0"
            Comment    :!"Расстояние от центра группы, которое считается нулевым"
