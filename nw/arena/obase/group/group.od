            Type       :!"DOUBLE"
            Name       :!"m_reachedDelta"
            DefaultVal :!"1.0"
            Comment    :!"Радиус, в пределах которого считается, что точка достигнута"
        }
        (TKEY 0 1){Attr }
        Attribute(ATRI 0 1){
            Type       :!"DOUBLE"
            Name       :!"m_maxViewDist"
            DefaultVal :!"300.0"
            Comment    :!"Максимальная дальность, при которой враг обнаруживается"
        }
        (TKEY 0 1){Attr }
        Attribute(ATRI 0 1){
            Type       :!"DOUBLE"
            Name       :!"m_findEnemyDist"
            DefaultVal :!"100.0"
            Comment    :!"радиус, в пределах которого ищем врагов"
        }
        (TKEY 0 1){Attr }
        Attribute(ATRI 0 1){
            Type       :!"DOUBLE"
            Name       :!"m_movingAttackingTimeIncrement"
            DefaultVal :!"2.0"
            Comment    :!""
        }
        (TKEY 0 1){EndOfAttr }
    }

    AttrClass(AC__ 0 0){
        (TKEY 0 1){EndOfAttrClass }
    }

    AttrClassData(ACD_ 0 0){
        (TKEY 0 1){EndOfAttrClassData }
    }


