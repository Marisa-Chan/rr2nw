$align 4
.486p
MODEL	FLAT,CPP
LOCALS
; align	4

include platform.inc

BEGIN_CODE_SEG

;========================================================================
include types.inc
include stack.inc
include get_s.inc
include subtloop.inc


SIZE_LUT_SHIFT equ 5
SIZE_LUT equ 32*32
;
;::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

align 8
ADrawGouraud:
	Public ADrawGouraud

	mov	edx,[ESP_topVert]
	mov	ebx,[ESP_bottomVert]
	mov	ecx,_gr_pYCache
        mov     eax,[_gr_polygon].color
        mov     esi,[edx].y
	mov	edx,[ebx].y
	mov	ebx,offset screen
	sub	edx,esi			;deltaY
	mov	edi,[ecx + esi*4]	;scrPtr
	mov	[ESP_count],edx
	;
        and     eax,000000ffh
        mov     [ESP_scr],esi
	sal	eax,4	;color*16
	mov	[ESP_startVert],ebx
	add	eax,_gr_pGouraud
	mov	[ESP_endVert],edi
	mov	ds:[?GouraudMaskColor],eax

TextLoopY:

	mov	esi,[ebx].xl
	mov	eax,[ebx].xr
	add	edi,esi
	;
	mov	edx,esi
	sub	esi,eax
	jg	End
	;
	mov	ebp,edi
	sub	edi,esi
	mov	ecx,[_gr_pDivCache + esi*4]
	mov	ds:[?EndLineAdr],edi

	mov	edi,[ESP_scr]
	mov	eax,[ebx].uzl
	inc	edi
	mov	esi,[ebx].uzr
	mov	[ESP_scr],edi
	mov	ebx,eax
	sal	edi,SIZE_LUT_SHIFT
	sub	eax,esi
	add	edi,edx
	imul	ecx
	shrd	eax,edx,Y_DIV_CACHE_PRES
	mov	edx,eax
	mov	esi,eax
	;
	sar	edx,16	;[dL]
	GetDW	mov	ecx,?GouraudMaskColor
	sal	esi,16	;{dL}<<16
	mov	eax,ebx
	sal	eax,16	;{L}
	dec	ebp
	sar	ebx,16	;[L]
	and	edi,SIZE_LUT - 1
	;sal	edi,2
	add	ecx,ebx	;Gouraud Mask Ptr
	;
        cmp     eax,[_LutMaskPtr + edi*4]
	sbb	ebx,ebx

InnerLoop:

	;eax - {L}<<16
        ;ebx - carry
	;ecx - G M Ptr
	;edx - [dL]
	;esi - {dL}<<16
	;edi - LUT_off
	;ebp - scr
	;
    	;
        inc     ebp                      ;u
        inc     edi                      ;v
        mov     bl,B_P [ecx+ebx]         ;u
        and     edi,(SIZE_LUT*1) - 1     ;v
        add     eax,esi                  ;u
        mov     B_P [ebp], bl            ;v
        adc     ecx,edx                  ;u
        cmp     eax,[_LutMaskPtr + edi*4];v
        sbb     ebx,ebx                  ;u
	;
	;
	GetDW	cmp	ebp,?EndLineAdr
	jnz	InnerLoop


End:
	mov	ebx,[ESP_startVert]
	mov	edi,[ESP_endVert]
	add	ebx,type Screen
	GetDWPub	add	edi,EXT_ScreenWidth9
	dec	[ESP_count]
	mov	[ESP_startVert],ebx
	mov	[ESP_endVert],edi
	jge	TextLoopY

jmp	END_TYPE_DRAW

	;
;=============================================================

;::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::;
;
;unused dd  1024 DUP(?)
;==========ASM extern Labels==============
align 4
extrn END_TYPE_DRAW:proc
extrn ENDD:proc
;==========ASM extern=====================
align 4
extrn _gr_vertices:dword
extrn interVert:dword
extrn _gr_polygon:dword
extrn screen:dword
extrn pYDivCache:dword
;===========C(++) extern==================
align 4
extrn   _gr_pYCache:dword
extrn p1DivCache:dword
extrn	_gr_nScreenWidth:dword
extrn	_gr_pGouraud:dword
;=============Module Data=================
