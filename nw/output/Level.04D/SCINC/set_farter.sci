func void main_CreateFarters()
var int ctID;
{
    ctID := s_AddClassTable( "Farter", 25  );  
    CreateFarter(ctID,"Farter.Attr.Factory", [3010,169,-2771]); // volcano

    CreateFarter(ctID,"Farter.Attr.Factory2", [4335,112.5,-3563] );//заводская труба 
    CreateFarter(ctID,"Farter.Attr.Factory2",[4383.5, 85,-3529] );//труба маленькая
    CreateFarter(ctID,"Farter.Attr.Factory2",[4339, 92.5,-3543.5] );//труба средняя

    CreateFarter(ctID,"Farter.Attr.Factory",[3370,90,-3276] ); //труба крематория
    CreateFarter(ctID,"Farter.Attr.Factory",[3382,90,-3282] );


    CreateFarter(ctID,"Farter.Attr.Factory2",[3328,119.5,-3134] );// завод у концлагеря
    CreateFarter(ctID,"Farter.Attr.Factory2", [3355,113,-2074] );//завод на полуострове (большая труба)
    CreateFarter(ctID,"Farter.Attr.Factory",[3357,92.5,-2052.5] );// завод на полуострове (малая трубы)
    CreateFarter(ctID,"Farter.Attr.Factory",[3134,80,-1992] );//  средняя труба около полуострова
    CreateFarter(ctID,"Farter.Attr.Factory",[3130,85,-1976] );// большая труба -..-..-..-
    CreateFarter(ctID,"Farter.Attr.Steam1",[1419,58,-3172] );//труба паровой машины на базе подлодок
    CreateFarter(ctID,"Farter.Attr.Factory2",[754,130, -2568] );//  труба заводика на ацтекской фабрике
    CreateFarter(ctID,"Farter.Attr.Steam1",[771,120.75, -2567] );// труба ацтекского двигателя на той же фабрике
    CreateFarter(ctID,"Farter.Attr.Steam1",[1164,83.75,-2398] );//труба ацтекского двигателя в большом городе

    CreateFarter(ctID,"Farter.Attr.Factory2",[1345,107.5,-2494] );//труба №1 ацтекского завода в большом городе
    CreateFarter(ctID,"Farter.Attr.Factory2",[1345,107.5,-2474] );//
    CreateFarter(ctID,"Farter.Attr.Factory", [1345,107.5,-2453] );//
    CreateFarter(ctID,"Farter.Attr.Factory",[1640,111,-2021] );//
    CreateFarter(ctID,"Farter.Attr.Factory2",[1711,111,-2094] );//

    CreateFarter(ctID,"Farter.Attr.Windmill",[1849,147,-3071] );//
    CreateFarter(ctID,"Farter.Attr.Windmill",[1870,147,-3074] );//
    CreateFarter(ctID,"Farter.Attr.Windmill",[1371,175,-3583] );//

}
